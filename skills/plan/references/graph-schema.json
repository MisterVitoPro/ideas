{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mistervitopro.dev/ideas/plan-graph-v1.schema.json",
  "title": "Ideas plan dependency graph v1",
  "description": "A versioned, host-neutral graph emitted from the normalized plan model.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "plan": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical plan identity shared by every artifact in the bundle."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "required": [
    "schemaVersion",
    "plan",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "task",
            "file",
            "module",
            "public-contract"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "owns",
            "depends-on",
            "imports",
            "exports",
            "produces",
            "consumes"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "assurance": {
          "type": "string",
          "enum": [
            "syntactically-verified",
            "declarative-unverified"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "target"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "imports"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "assurance"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "exports"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "assurance"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "produces"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "assurance"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "consumes"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "assurance"
            ]
          }
        }
      ]
    }
  }
}
